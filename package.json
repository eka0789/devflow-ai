{
  "name": "devflow-ai",
  "private": true,
  "version": "0.1.0",
  "description": "DevFlow AI — personal AI software engineering workspace (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @devflow/api\" \"npm run dev -w @devflow/web\"",
    "dev:api": "npm run dev -w @devflow/api",
    "dev:web": "npm run dev -w @devflow/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start -w @devflow/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
