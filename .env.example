# ---- DevFlow AI backend configuration ----
# Copy to .env and adjust. Never commit the real .env file.

# HTTP port for the API server
PORT=4310

# Origin(s) allowed to call the API (comma-separated). Vite dev server default:
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file (created automatically)
DB_PATH=./data/devflow.db

# Secret used to sign JWTs and encrypt stored credentials (GitHub PAT, AI API keys).
# REQUIRED in production. If unset in dev, an ephemeral secret is generated (sessions
# and stored secrets reset on restart) with a loud warning.
APP_SECRET=

# GitHub webhook secret — must match the secret configured on the GitHub App/webhook.
GITHUB_WEBHOOK_SECRET=

# Default AI provider (can also be configured per-user in Settings > AI Provider).
# OpenAI-compatible chat completions endpoint, e.g. https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Log level: debug | info | warn | error
LOG_LEVEL=info
